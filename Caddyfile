# PrettyDocs static site. Railway sets $PORT; SITE_ROOT is /srv in the image (set it to dist/ for a local run).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * {$SITE_ROOT:/srv}
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'"
		-Server
	}

	# Hashed build files never change; content files and icons change on each export; the app shell must always revalidate.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@content path /content/* /icons/*
	header @content Cache-Control "public, max-age=300"
	@app not path /assets/* /content/* /icons/*
	header @app Cache-Control "no-cache"

	# Build files, content and icons are served as they are: a missing file is a 404.
	handle /assets/* {
		file_server
	}
	handle /content/* {
		file_server
	}
	handle /icons/* {
		file_server
	}
	# Single-page app: any other path that is not a file gets index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}
